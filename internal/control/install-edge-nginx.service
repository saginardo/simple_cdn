[Unit]
Description=simple_cdn managed Nginx
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
PIDFile=/opt/cdn-edge/nginx/run/nginx.pid
ExecStartPre=/opt/cdn-edge/nginx/sbin/nginx -t -q
ExecStart=/opt/cdn-edge/nginx/sbin/nginx
ExecReload=/opt/cdn-edge/nginx/sbin/nginx -s reload
ExecStop=/bin/kill -s QUIT $MAINPID
TimeoutStartSec=30s
TimeoutStopSec=30s
Restart=on-failure
RestartSec=2s
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/opt/cdn-edge

[Install]
WantedBy=multi-user.target
