  "cards": [
    {
      "dot": "cyan",
      "title": "主链路",
      "items": [
        "终端用户直连边缘节点，Cloudflare 仅作权威 DNS，不代理流量",
        "边缘 Nginx 承担缓存、WAF、压缩与证书终止",
        "回源支持 HTTP(S) / gRPC 主备切换与 WireGuard 加密隧道"
      ]
    },
    {
      "dot": "emerald",
      "title": "控制面闭环",
      "items": [
        "mTLS 通道下发站点配置、证书与升级任务，节点确认加载后发布才成功",
        "失败自动回滚到上一份正常配置与 TLS 文件",
        "DNS A 记录按节点健康状态对账，带滞回避免抖动"
      ]
    },
    {
      "dot": "violet",
      "title": "数据与可观测性",
      "items": [
        "SQLite 保存站点 / 节点 / 加密凭据，ClickHouse 保留原始日志与分钟聚合",
        "边缘访问日志经 mTLS 通道上报控制面 /api/edge/v1/logs",
        "Restic 每日加密备份 SQLite / ClickHouse / 证书材料"
      ]
    }
  ]
