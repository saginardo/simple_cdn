<clickhouse>
  <profiles>
    <default>
      <max_memory_usage>512000000</max_memory_usage>
      <max_execution_time>30</max_execution_time>
      <query_profiler_real_time_period_ns>0</query_profiler_real_time_period_ns>
      <query_profiler_cpu_time_period_ns>0</query_profiler_cpu_time_period_ns>
      <memory_profiler_step>0</memory_profiler_step>
      <log_processors_profiles>0</log_processors_profiles>
      <log_query_views>0</log_query_views>
      <log_queries_min_type>QUERY_FINISH</log_queries_min_type>
      <!-- Coalesce concurrent inserts while acknowledging only flushed data. -->
      <async_insert>1</async_insert>
      <wait_for_async_insert>1</wait_for_async_insert>
      <async_insert_use_adaptive_busy_timeout>0</async_insert_use_adaptive_busy_timeout>
      <async_insert_busy_timeout_ms>5000</async_insert_busy_timeout_ms>
      <async_insert_max_data_size>1048576</async_insert_max_data_size>
    </default>
  </profiles>
</clickhouse>
